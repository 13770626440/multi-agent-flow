# Multi-Agent-Flow MVP 环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# OpenClaw 配置
# ============================================
# LLM API Key（阿里云 DashScope）
LLM_API_KEY=your_api_key_here
# LLM 模型
LLM_MODEL=qwen3.6-plus
# LLM Base URL
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenClaw Gateway Token（用于API认证）
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here

# ============================================
# OpenMOSS 配置
# ============================================
# OpenMOSS 注册令牌
OPENMOSS_REGISTRATION_TOKEN=maf_registration_token
# OpenMOSS 管理员密码
OPENMOSS_ADMIN_PASSWORD=admin123
# OpenMOSS Planner Agent Token（注册后获取）
OPENMOSS_PLANNER_TOKEN=om_planner_token_here
# OpenMOSS Executor Agent Token（注册后获取）
OPENMOSS_EXECUTOR_TOKEN=om_executor_token_here
# OpenMOSS Reviewer Agent Token（注册后获取）
OPENMOSS_REVIEWER_TOKEN=om_reviewer_token_here

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRES_DB=maf_db
POSTGRES_USER=maf_user
POSTGRES_PASSWORD=maf_password
